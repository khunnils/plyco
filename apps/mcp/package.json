{
  "name": "@plyco/mcp",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "plyco-mcp": "dist/index.js",
    "plyco-mcp-hosted": "dist/hosted.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "start:hosted": "node dist/hosted.js",
    "dev": "tsx src/index.ts",
    "dev:hosted": "tsx src/hosted.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@plyco/api-client": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
