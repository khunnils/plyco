---
import Layout from "../layouts/Layout.astro";
import ProductPreview from "../components/ProductPreview.astro";
import Hosting from "../components/Hosting.astro";
import { company, services, dataTypes, activities } from "../content/company";

const features = [
  { title: "Client requests", description: "Collect briefs and supporting documents in one shared queue." },
  { title: "Clear ownership", description: "Assign an owner and keep the next step visible to your team." },
  { title: "Project files", description: "Keep documents and deliverable versions alongside the brief." },
  { title: "A client portal", description: "Give invited clients a place to check progress and share feedback." },
  { title: "Recorded approvals", description: "Keep each decision, reviewer, and timestamp with the exact version." },
  { title: "Regional hosting", description: "Choose EU or US hosting for your workspace and connected portal." },
];

// All comparison entries describe invented products for this static demo.
const comparison = [
  ["Best suited to", "Agency–client work", "Internal task planning", "Document collaboration"],
  ["Request intake", "Client briefs & files", "Team-created tasks", "File requests"],
  ["Dedicated client portal", "Included", "Guest task access", "Shared folders"],
  ["Version-specific approvals", "Recorded decisions", "Task status only", "Recorded decisions"],
  ["Project file sharing", "Included", "Attachments", "Included"],
  ["EU or US hosting choice", "Per workspace", "Fixed region", "Per workspace"],
];
---

<Layout
  title="Client work, without the back-and-forth"
  description="Brieflane is a fictional B2B SaaS startup for agencies: client requests, documents, and approvals with a team workspace, customer portal, and EU or US hosting."
>
  <section class="hero container">
    <div class="hero-intro">
      <h1>Less chasing.<br />More good work.</h1>
      <div class="hero-copy">
        <p class="hero-description">Client requests, project files, and approvals in one clear place. Give your team a workspace and your clients a front door.</p>
        <div class="hero-actions">
          <a class="button" href="/workspace/">Explore the workspace <span aria-hidden="true">↗</span></a>
          <a class="button button-secondary" href="/portal/">See the client experience <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-note">For creative and digital agencies in the EU and US.</p>
      </div>
    </div>
    <div class="hero-product">
      <ProductPreview />
    </div>
  </section>
  <section id="product" class="section container">
    <div class="section-heading centered-heading">
      <h2>Everything your client work needs.</h2>
      <p>One place to take a request from the first brief to the final approval.</p>
    </div>
    <ul class="product-features">
      {features.map((feature) => (
        <li>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </li>
      ))}
    </ul>
    <div class="service-grid">
      {Object.values(services).map((service, index) => (
        <article class="service-card">
          <h3>{service.name}</h3>
          <p>{service.description}</p>
          <a class="text-link" href={service.path}>
            Explore the {index === 0 ? "workspace" : "portal"} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>
  <section id="compare" class="section comparison-section">
    <div class="container">
      <div class="section-heading centered-heading">
        <h2>Find the right fit for your workflow.</h2>
        <p>Brieflane brings the agency workspace and client experience together.</p>
      </div>
      <div class="table-scroll comparison-scroll" tabindex="0" role="region" aria-label="Product comparison, scroll horizontally on small screens">
        <table class="comparison-table">
          <caption>Illustrative comparison: Brieflane, Taskboard Co., and Filebox Co. are fictional products. All capabilities below are invented for this demo.</caption>
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col" class="comparison-featured">Brieflane</th>
              <th scope="col">Taskboard Co.</th>
              <th scope="col">Filebox Co.</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map(([feature, brieflane, taskboard, filebox]) => (
              <tr>
                <th scope="row">{feature}</th>
                <td class="comparison-featured">{brieflane}</td>
                <td>{taskboard}</td>
                <td>{filebox}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <Hosting />
  <section class="section container privacy-section">
    <div>
      <h2>
        Clear practices.<br />Honest progress.
      </h2><p>
        Our fictional business has documented GDPR practices: a data processing
        agreement, a retention policy, rights-request handling, and safeguards
        for international transfers. We do not claim certification or guaranteed
        compliance.
      </p><p>
        We do not use AI, train models on customer data, sell personal data, or
        make automated decisions with legal or similarly significant effects.
        The product is not intended for health data or other special-category
        personal data.
      </p><a class="text-link" href="/privacy/"
        >Read our privacy policy <span aria-hidden="true">↗</span></a>
    </div><aside class="readiness-card">
      <h3>
        A foundation we can explain.
      </h3><ul class="feature-list">
        <li>
          <span aria-hidden="true">✓</span>Encryption in transit and at rest
        </li><li>
          <span aria-hidden="true">✓</span>Region-specific backups and
          role-based access
        </li><li>
          <span aria-hidden="true">✓</span>Documented incident notification
          process
        </li>
      </ul><div class="pending-note">
        <strong>Still on our list</strong><p>
          Our first formal incident-response exercise and independent
          penetration test are pending.
        </p>
      </div><a class="text-link" href="/security/"
        >Security &amp; providers <span aria-hidden="true">↗</span></a>
    </aside>
  </section>
  <section class="section business-section">
    <div class="container">
      <div class="section-heading">
        <h2>
          A small team, making<br />client work feel simpler.
        </h2><p>
          {company.legalName} is a fictional {company.teamSize}-person software
          startup based in {company.country}. We serve creative and digital
          agencies, their employees, and their invited business clients across
          the European Union and United States.
        </p>
      </div><div class="business-details">
        <div>
          <span class="eyebrow">REGISTERED OFFICE</span><p>{company.address}</p>
        </div><div>
          <span class="eyebrow">CONTACTS · ILLUSTRATIVE ONLY</span><p>
            General: {company.contactEmail}<br />Privacy: {
              company.privacyEmail
            }<br />Security: {company.securityEmail}
          </p>
        </div>
      </div><details class="business-disclosure">
        <summary>Data processing &amp; business responsibilities</summary>
        <div class="business-facts">
        <div>
          <h3>The data our services process</h3><dl>
            {
              dataTypes.map((type) => (
                <div>
                  <>
                    <dt>{type.name}</dt>
                    <dd>{type.description}</dd>
                  </>
                </div>
              ))
            }
          </dl>
        </div><div>
          <h3>Why we process it</h3><dl>
            {
              activities.map((activity) => (
                <div>
                  <>
                    <dt>{activity.name}</dt>
                    <dd>{activity.purpose}</dd>
                  </>
                </div>
              ))
            }
          </dl>
        </div>
      </div><p class="business-footnote">
        We act as a processor for agency-controlled project content and client
        records, and as a controller for our own account administration,
        billing, security, support, and opted-in marketing. The marketing
        website is a separate service; these previews do not process real
        customer data.
      </p>
      </details>
    </div>
  </section>
  <section class="closing-section container">
    <h2>
      A little less admin.<br />A little more momentum.
    </h2><a class="button" href="/workspace/"
      >Explore Brieflane <span aria-hidden="true">↗</span></a
    ><p>No signup. No real data. Just a clearer picture of the product.</p>
  </section>
</Layout>
