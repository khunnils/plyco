---
import Layout from "../layouts/Layout.astro";
import ProductPreview from "../components/ProductPreview.astro";
import Hosting from "../components/Hosting.astro";
import { company, services, dataTypes, activities } from "../content/company";
---

<Layout
  title="Client work, without the back-and-forth"
  description="Brieflane is a fictional B2B SaaS startup for agencies: client requests, documents, and approvals with a team workspace, customer portal, and EU or US hosting."
>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="tiny-star" aria-hidden="true">✳</span> BUILT FOR SMALL AGENCIES
        WITH BIG IDEAS
      </p><h1>
        Less chasing.<br />More <span class="hero-accent">good work.</span>
      </h1><p class="hero-description">
        Client requests, project files, and approvals in one clear place. Give
        your team a workspace and your clients a front door.
      </p><div class="hero-actions">
        <a class="button" href="/workspace/"
          >Explore the workspace <span aria-hidden="true">↗</span></a
        ><a class="text-link" href="/portal/"
          >See the client experience <span aria-hidden="true">→</span></a>
      </div><p class="hero-note">
        For creative and digital agencies in the EU and US.<br />An early-stage
        product, illustrated with fictional data.
      </p>
    </div>
    <div class="hero-side">
      <div class="brief-card">
        <p class="eyebrow">A BRIEF, NOT AN EMAIL THREAD</p><h2>
          Autumn campaign
        </h2><p>Juniper Studio · Brand &amp; creative</p><div
          class="brief-divider"
        >
        </div><span class="status accent">In progress</span><div
          class="brief-steps"
        >
          <div>
            <span class="step-complete">✓</span><span
              >Brief received<small>Everything the team needs to start.</small
              ></span>
          </div><div>
            <span class="step-complete">✓</span><span
              >Files in one place<small>No more “which version?”</small></span>
          </div><div>
            <span class="step-pending">3</span><span
              >Ready for a clear decision<small
                >Feedback attached to the work.</small
              ></span>
          </div>
        </div><div class="brief-footer">
          <span class="avatar">MC</span><span
            >Owned by Maya<span class="muted"> · Northline Agency</span></span>
        </div>
      </div><div class="hero-sticker">
        <span aria-hidden="true">↗</span> From brief<br />to approved.
      </div>
    </div>
  </section>
  <div class="promise-strip container">
    <span>One shared source of truth</span><span>A separate client portal</span
    ><span>EU &amp; US hosting choices</span><span
      >Privacy practices, in plain sight</span>
  </div>
  <section id="product" class="section container">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">TWO SPACES. ONE CONNECTED WORKFLOW.</p><h2>
          Your team gets clarity.<br />Your clients get a portal.
        </h2>
      </div><p>
        Brieflane is subscription software for small creative and digital
        agencies. Replace scattered inboxes and file links with a shared path
        from request to approval.
      </p>
    </div>
    <div class="service-grid">
      {
        Object.values(services).map((service, index) => (
          <article
            class:list={["service-card", { "service-portal": index === 1 }]}
          >
            <>
              <span class="service-number">0{index + 1}</span>
              <p class="eyebrow">{service.audience}</p>
              <h3>{service.name}</h3>
              <p>{service.description}</p>
              <ul class="feature-list">
                {service.features.map((feature) => (
                  <li>
                    <span aria-hidden="true">✓</span>
                    {feature}
                  </li>
                ))}
              </ul>
              <a class="text-link" href={service.path}>
                Explore the {index === 0 ? "workspace" : "portal"}{" "}
                <span aria-hidden="true">↗</span>
              </a>
            </>
          </article>
        ))
      }
    </div>
    <div class="product-showcase"><ProductPreview compact /></div>
  </section>
  <section class="section workflow-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">FROM “CAN YOU HELP?” TO “LOOKS GOOD.”</p><h2>
          A calmer way to get there.
        </h2>
      </div><div class="workflow-grid">
        <article>
          <span class="workflow-number">01 /</span><h3>
            Start with a clear request
          </h3><p>
            Clients submit a brief and supporting files through their portal.
            Your team sees the context together.
          </p>
        </article><article>
          <span class="workflow-number">02 /</span><h3>
            Keep the work moving
          </h3><p>
            Assign an owner, organize documents, and share progress. Service
            emails let people know when something changes.
          </p>
        </article><article>
          <span class="workflow-number">03 /</span><h3>Close the loop</h3><p>
            Clients review a deliverable and approve the exact version. The
            decision and its timestamp stay with the project.
          </p>
        </article>
      </div>
    </div>
  </section>
  <Hosting />
  <section class="section container privacy-section">
    <div>
      <p class="eyebrow">PRIVACY IS PART OF THE PRODUCT</p><h2>
        Clear practices.<br />Honest progress.
      </h2><p>
        Our fictional business has documented GDPR practices: a data processing
        agreement, a retention policy, rights-request handling, and safeguards
        for international transfers. We do not claim certification or guaranteed
        compliance.
      </p><p>
        We do not use AI, train models on customer data, sell personal data, or
        make automated decisions with legal or similarly significant effects.
        The product is not intended for health data or other special-category
        personal data.
      </p><a class="text-link" href="/privacy/"
        >Read our privacy policy <span aria-hidden="true">↗</span></a>
    </div><aside class="readiness-card">
      <p class="eyebrow">EARLY STAGE, OPEN ABOUT IT</p><h3>
        A foundation we can explain.
      </h3><ul class="feature-list">
        <li>
          <span aria-hidden="true">✓</span>Encryption in transit and at rest
        </li><li>
          <span aria-hidden="true">✓</span>Region-specific backups and
          role-based access
        </li><li>
          <span aria-hidden="true">✓</span>Documented incident notification
          process
        </li>
      </ul><div class="pending-note">
        <strong>Still on our list</strong><p>
          Our first formal incident-response exercise and independent
          penetration test are pending.
        </p>
      </div><a class="text-link" href="/security/"
        >Security &amp; providers <span aria-hidden="true">↗</span></a>
    </aside>
  </section>
  <section class="section business-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">ABOUT BRIEFLANE</p><h2>
          A small team, making<br />client work feel simpler.
        </h2><p>
          {company.legalName} is a fictional {company.teamSize}-person software
          startup based in {company.country}. We serve creative and digital
          agencies, their employees, and their invited business clients across
          the European Union and United States.
        </p>
      </div><div class="business-details">
        <div>
          <span class="eyebrow">REGISTERED OFFICE</span><p>{company.address}</p>
        </div><div>
          <span class="eyebrow">CONTACTS · ILLUSTRATIVE ONLY</span><p>
            General: {company.contactEmail}<br />Privacy: {
              company.privacyEmail
            }<br />Security: {company.securityEmail}
          </p>
        </div>
      </div><div class="business-facts">
        <div>
          <h3>The data our services process</h3><dl>
            {
              dataTypes.map((type) => (
                <div>
                  <>
                    <dt>{type.name}</dt>
                    <dd>{type.description}</dd>
                  </>
                </div>
              ))
            }
          </dl>
        </div><div>
          <h3>Why we process it</h3><dl>
            {
              activities.map((activity) => (
                <div>
                  <>
                    <dt>{activity.name}</dt>
                    <dd>{activity.purpose}</dd>
                  </>
                </div>
              ))
            }
          </dl>
        </div>
      </div><p class="business-footnote">
        We act as a processor for agency-controlled project content and client
        records, and as a controller for our own account administration,
        billing, security, support, and opted-in marketing. The marketing
        website is a separate service; these previews do not process real
        customer data.
      </p>
    </div>
  </section>
  <section class="closing-section container">
    <p class="eyebrow">TAKE A LOOK AROUND</p><h2>
      A little less admin.<br />A little more momentum.
    </h2><a class="button" href="/workspace/"
      >Explore Brieflane <span aria-hidden="true">↗</span></a
    ><p>No signup. No real data. Just a clearer picture of the product.</p>
  </section>
</Layout>
