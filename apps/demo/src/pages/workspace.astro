---
import Layout from "../layouts/Layout.astro";
import ProductPreview from "../components/ProductPreview.astro";
import { services } from "../content/company";
---

<Layout
  title="Team workspace preview"
  description={services.workspace.description}
>
  <section class="container preview-page">
    <a class="back-link" href="/">← Back to Brieflane</a><div
      class="section-heading"
    >
      <p class="eyebrow">PRIMARY SERVICE · TEAM WORKSPACE</p><h1>
        {services.workspace.name}
      </h1><p>{services.workspace.description}</p>
    </div><div class="preview-notice">
      <strong>Static product preview</strong><span
        >All people, organizations, and documents below are synthetic. Displayed
        controls do not create requests, authenticate users, or upload files.</span>
    </div><ProductPreview /><div class="preview-explainer">
      <article>
        <h2>A shared team view</h2><p>
          Agency staff see incoming requests, assign owners, share project
          documents, and review client decisions. The fictional product isolates
          each agency tenant and limits access by role.
        </p>
      </article><article>
        <h2>Connected to your client portal</h2><p>
          Each workspace has a separate customer portal. Clients see only the
          projects and documents shared with them. Both services use the
          workspace’s selected EU or US hosting region.
        </p><a class="text-link" href="/portal/">See the customer portal →</a>
      </article>
    </div>
  </section>
</Layout>
