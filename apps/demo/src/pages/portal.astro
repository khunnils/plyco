---
import Layout from "../layouts/Layout.astro";
import ProductPreview from "../components/ProductPreview.astro";
import { services } from "../content/company";
---

<Layout
  title="Customer portal preview"
  description={services.portal.description}
>
  <section class="container preview-page">
    <a class="back-link" href="/">← Back to Brieflane</a><div
      class="section-heading"
    >
      <p class="eyebrow">SEPARATE SERVICE · CLIENT EXPERIENCE</p><h1>
        {services.portal.name}
      </h1><p>{services.portal.description}</p>
    </div><div class="preview-notice">
      <strong>Static product preview</strong><span
        >You are viewing synthetic records for Juniper Studio. There is no
        login, live upload, submission, or approval action on this demo site.</span>
    </div><ProductPreview mode="portal" /><div class="preview-explainer">
      <article>
        <h2>A front door for client work</h2><p>
          In the fictional product, invited clients submit requests and
          supporting files, see project progress, and approve specific
          deliverable versions. Their reviewer identity and decision timestamp
          are recorded.
        </p>
      </article><article>
        <h2>The same region as your agency</h2><p>
          The portal processes client contacts, requests, documents, approval
          records, and security logs. Its application storage and backups follow
          the linked workspace’s Ireland or Northern Virginia region.
        </p><a class="text-link" href="/privacy/">Read about data handling →</a>
      </article>
    </div>
  </section>
</Layout>
